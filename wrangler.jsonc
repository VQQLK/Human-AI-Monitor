{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "human-ai-monitor-collector",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "human-ai-monitor-db",
			"database_id": "4b4a909a-5088-48f4-aaed-ef393c61b6dd"
		}
	],
	"ai": { "binding": "AI" },
	// Architecture v2: 5 cron triggers (Cloudflare Free plan limit)
	// 13:00-13:45 UTC: 4 batches (daytime collection, 32 of 41 sources)
	// 23:00 UTC: 1 batch (evening collection, remaining 9 sources)
	// Each batch runs as separate request to stay under 50-subrequest limit
	"triggers": {
		"crons": [
			"0 13 * * *",
			"15 13 * * *",
			"30 13 * * *",
			"45 13 * * *",
			"0 23 * * *"
		]
	},
	"vars": { "CLASSIFIER_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8" }
}
