{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "human-ai-monitor-collector",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "human-ai-monitor-db",
			"database_id": "4b4a909a-5088-48f4-aaed-ef393c61b6dd"
		}
	],
	"ai": { "binding": "AI" },
	// NOTE: Cloudflare treats day-of-week "1" as Sunday in cron (verified empirically
	// 2026-09-22: "0 6 * * 1" fired on 2026-09-20, a Sunday). To run on Monday we use "2".
	"triggers": { "crons": ["0 6 * * 2", "15 6 * * 2", "30 6 * * 2", "45 6 * * 2"] },
	"vars": { "CLASSIFIER_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8" }
}
