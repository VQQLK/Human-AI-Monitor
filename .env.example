# Cloudflare API (для деплоя через Wrangler)
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Классификатор (Cloudflare Workers AI)
# Доступные модели:
#   @cf/qwen/qwen3-30b-a3b-fp8
#   @cf/meta/llama-4-scout-17b-16e-instruct
#   @cf/deepseek-ai/deepseek-r1-distill-qwen-32b
CLASSIFIER_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# База данных и R2 настраиваются через wrangler.jsonc (bindings DB и 
RAW_DATA_BUCKET)
# Workers AI настраивается через wrangler.jsonc (binding AI)
